# Copy this to .env and fill in your exchange API keys
# For paper trading, keys are optional — the bot runs without them

EXCHANGE=kraken
SYMBOL=DOGE/USDT
TIMEFRAME=15m

# Exchange used for backtest history only (Kraken serves just its latest 720 candles)
HISTORY_EXCHANGE=kucoin

# Optional: only needed for live trading (not paper trading)
API_KEY=
API_SECRET=

# Execution cost model (fractions: 0.004 = 0.40%), applied to every simulated fill
FEE_PCT=0.004
SLIPPAGE_PCT=0.0005

# Strategy filters
# RSI_OVERSOLD_BUY=1 buys when RSI < RSI_OVERSOLD even without a crossover (0 disables)
RSI_OVERSOLD_BUY=1
# TREND_PERIOD>0 only opens longs while close is above an EMA of that length (0 disables)
TREND_PERIOD=0

# CoinGecko cross-check of backtest data (optional demo API key for higher rate limits)
COINGECKO_ID=dogecoin
COINGECKO_API_KEY=

# Strategy selection: ma_rsi (EMA crossover + RSI) or trend (SMA trend-following)
STRATEGY=ma_rsi
TREND_SMA_PERIOD=200
TREND_BAND=0.0

# Position sizing: risk (stop-based) or allocation (fraction of balance)
SIZING_MODE=risk
ALLOCATION_PCT=1.0
USE_STOP_LOSS=1
