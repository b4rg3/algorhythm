# Copy this to .env and fill in your exchange API keys
# For paper trading, keys are optional — the bot runs without them

EXCHANGE=kraken
SYMBOL=DOGE/USDT
TIMEFRAME=15m

# Exchange used for backtest history only (Kraken serves just its latest 720 candles)
HISTORY_EXCHANGE=kucoin

# Optional: only needed for live trading (not paper trading)
API_KEY=
API_SECRET=

# Execution cost model (fractions: 0.004 = 0.40%), applied to every simulated fill
FEE_PCT=0.004
SLIPPAGE_PCT=0.0005
